    <sys:String x:Key="Help_Manuals">2. Uso:</sys:String>
    <sys:String x:Key="Manuals_Config">(1). Configurar los parámetros en el panel de configuración</sys:String>
    <sys:String x:Key="Manuals_Config_Opacity">Opacidad: 100 = totalmente opaco,</sys:String>
    <sys:String x:Key="Manuals_Config_Opacity_Important">Nota: 0 = totalmente transparente, la marca no se ve</sys:String>
    <sys:String x:Key="Manuals_Config_Rotate">Ángulo: de -180 a 180 grados, rotación sobre el centro del panel</sys:String>
    <sys:String x:Key="Manuals_Config_FontFamily">Fuente: puede elegir todas las fuentes del sistema,</sys:String>
    <sys:String x:Key="Manuals_Config_FontFamily_Important">Nota: las marcas chinas se muestran mal con la mayoría de fuentes occidentales</sys:String>
    <sys:String x:Key="Manuals_Config_FontSize">Tamaño: tamaño del texto de la marca (píxeles), consulte</sys:String>
    <sys:String x:Key="Manuals_Config_FontSize_Link">el enlace de equivalencias</sys:String>
    <sys:String x:Key="Manuals_Config_FontColor">Color del texto: color liso o degradado</sys:String>
    <sys:String x:Key="Manuals_Config_FontStyle">Estilo: negrita, cursiva, subrayado, tachado</sys:String>
    <sys:String x:Key="Manuals_Config_Horizontal_Dis">Espaciado horizontal: desplazamiento horizontal entre marcas</sys:String>
    <sys:String x:Key="Manuals_Config_Vetical_Dis">Espaciado vertical: desplazamiento vertical entre marcas</sys:String>
    <sys:String x:Key="Manuals_Config_Dis_Important">(espaciado pequeño = marcas superpuestas)</sys:String>

    <sys:String x:Key="Manuals_Task">(2). Configurar carpetas en el panel de tareas</sys:String>

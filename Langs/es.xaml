    <sys:String x:Key="Help_Function">1. Funciones:</sys:String>
    <sys:String x:Key="Function_1">Probar el efecto de la marca de agua y guardar localmente el procesado de un archivo</sys:String>
    <sys:String x:Key="Function_2">Tarea de marca de agua sobre las imágenes (PDF incluido) de las carpetas configuradas.</sys:String>
